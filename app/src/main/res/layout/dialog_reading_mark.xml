<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:text="@string/reading_mark"
        android:textColor="@color/primaryText"
        android:textSize="18sp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mark_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:textColor="@color/secondaryText"
                android:textSize="13sp" />
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/mark_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/reading_mark" />
            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/mark_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/mark_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />
            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/mark_locate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="@string/reading_mark_locate"
                android:textSize="14sp" />
            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/mark_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="@string/reading_mark_current"
                android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/mark_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:hint="@string/reading_mark_reason"
                android:textSize="14sp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginVertical="12dp"
                android:background="@color/bg_divider_line" />
            <TextView
                android:id="@+id/mark_skipped_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reading_mark_skipped"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/mark_skipped_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/mark_choose_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="@string/reading_mark_range"
                android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/mark_range_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/mark_from"
                    android:text="@string/reading_mark_from"
                    android:textColor="@color/secondaryText"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/mark_from"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/reading_mark_from" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/mark_to"
                    android:text="@string/reading_mark_to"
                    android:textColor="@color/secondaryText"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/mark_to"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/reading_mark_to" />
                <io.legado.app.ui.widget.text.AccentTextView
                    android:id="@+id/mark_add_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/reading_mark_skip_add"
                    android:textSize="14sp" />
                <io.legado.app.ui.widget.text.AccentTextView
                    android:id="@+id/mark_remove_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/reading_mark_skip_remove"
                    android:textSize="14sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="@string/reading_mark_catalog_hint"
                android:textColor="@color/secondaryText"
                android:textSize="12sp" />
            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/mark_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="@string/reading_mark_clear"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:gravity="end"
        android:orientation="horizontal">
        <io.legado.app.ui.widget.text.AccentTextView
            android:id="@+id/mark_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:text="@string/cancel"
            android:textSize="14sp" />
        <io.legado.app.ui.widget.text.AccentTextView
            android:id="@+id/mark_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:text="@string/action_save"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
