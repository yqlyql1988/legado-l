<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/range"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/read_record_manage_filter" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:text="@string/read_statistics_choose_day" />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/hour"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/read_record_manage_hour" />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/presets"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/read_record_manage_presets"
            android:contentDescription="@string/read_record_manage_presets" />
        <include
            android:id="@+id/minimum"
            layout="@layout/view_read_statistics_minimum" />
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/upper_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/read_record_manage_upper_enabled" />
        <include
            android:id="@+id/maximum"
            layout="@layout/view_read_statistics_minimum" />
    </LinearLayout>
</ScrollView>
