<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/primaryText"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/hours"
            style="@style/ReadStatisticsDurationInput"
            android:layout_width="56dp"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/ReadStatisticsDurationUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_statistics_hour_unit" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/minutes"
            style="@style/ReadStatisticsDurationInput"
            android:layout_width="40dp"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/ReadStatisticsDurationUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_statistics_minute_unit" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/seconds"
            style="@style/ReadStatisticsDurationInput"
            android:layout_width="40dp"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/ReadStatisticsDurationUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:text="@string/read_statistics_second_unit" />
    </LinearLayout>

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/md_red_400"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
