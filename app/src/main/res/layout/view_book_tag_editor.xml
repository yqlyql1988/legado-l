<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <io.legado.app.ui.widget.text.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/book_custom_tags"
        app:helperText="@string/book_custom_tags_hint">

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_custom_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:minLines="2" />
    </io.legado.app.ui.widget.text.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/book_tag_pick_hint"
        android:textColor="@color/secondaryText"
        android:textSize="12sp" />

    <io.legado.app.ui.widget.text.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/book_tag_existing_search">

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_common_tag_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true" />
    </io.legado.app.ui.widget.text.TextInputLayout>

    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/tv_common_tag_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:minHeight="40dp"
        android:paddingHorizontal="8dp"
        android:visibility="gone" />

    <io.legado.app.ui.widget.LabelsBar
        android:id="@+id/lb_common_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:alignItems="center"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/tv_common_tag_expand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:minHeight="40dp"
        android:paddingHorizontal="8dp"
        android:visibility="gone" />
</LinearLayout>
