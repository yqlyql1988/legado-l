<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="2dp"
    android:paddingEnd="6dp"
    android:paddingBottom="2dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/tv_relocation_quote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_relocation_expand"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="@string/reading_note_expand"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_relocation_find"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="@string/reading_note_find_in_book"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_relocation_cancel"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="@string/cancel"
        android:textSize="12sp" />
</LinearLayout>
